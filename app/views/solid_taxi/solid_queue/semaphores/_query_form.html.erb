<% local_assigns[:model] %>

<%= render "solid_taxi/details", open: model.any_queries?, summary: I18n.t("shared.search") do %>
  <%= form_with(model:, url: url_for, method: :get) do |form| %>
    <%= fieldset_tag(I18n.t("shared.search"), class: "solid-taxi--fieldset solid-taxi--fieldset--block") do %>
      <%= render "solid_taxi/form/input", form:, type: :text, attribute: :key, label: SolidQueue::Semaphore.human_attribute_name(:key) %>

      <%= fieldset_tag(SolidQueue::Job.human_attribute_name(:value), class: "solid-taxi--fieldset solid-taxi--fieldset--inline" ) do %>
        <%= render "solid_taxi/form/input", form:, type: :number, attribute: :value_from, label: I18n.t("shared.from") %>
        <%= render "solid_taxi/form/input", form:, type: :number, attribute: :value_to, label: I18n.t("shared.from") %>
      <% end %>

      <%= fieldset_tag(SolidQueue::Job.human_attribute_name(:expires_at), class: "solid-taxi--fieldset solid-taxi--fieldset--inline" ) do %>
        <%= render "solid_taxi/form/input", form:, type: :datetime, attribute: :expires_at_from, label: I18n.t("shared.from") %>
        <%= render "solid_taxi/form/input", form:, type: :datetime, attribute: :expires_at_to, label: I18n.t("shared.to") %>
      <% end %>
    <% end %>

    <%= form.submit I18n.t("shared.search"), name: nil %>
    <%= render "solid_taxi/form/reset_link" %>
  <% end %>
<% end %>
