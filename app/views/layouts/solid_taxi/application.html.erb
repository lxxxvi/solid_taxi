<!DOCTYPE html>
<html>
<head>
  <title>Solid Taxi</title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <style type="text/css">
    <%= SolidTaxi::Engine.root.join("app/assets/stylesheets/solid_taxi/application.css").read %>
  </style>
</head>
<body>
  <header>
    <%= render "solid_taxi/primary_navigation" %>
  </header>

  <main>
    <%= yield %>
  </main>

  <footer>
    <%= render "solid_taxi/footer" %>
  </footer>
</body>
</html>
